{
  "manifest_version": 3,
  "name": "Runet Access",
  "short_name": "Runet Access",
  "version": "0.1.0",
  "description": "Connect only the gov-site traffic of this Chrome profile through a VLESS key. Prototype built on MagicProxy (MIT).",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "proxy",
    "privacy",
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Runet Access",
    "default_popup": "src/gov/gov.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "homepage_url": "https://github.com/indolass/runet-access",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "host_permissions": [
    "https://api.country.is/*",
    "https://ipwho.is/*",
    "https://api.ipify.org/*"
  ]
}
